# Production. Copy to env/prod.env ON THE SERVER and fill in. Never commit the filled
# copy, never build it into an image, and never put it in the repository working tree
# that CI checks out.
#
#   docker compose --env-file env/prod.env --profile app --profile worker up -d
#
# BETTER THAN A FILE. A 0600 env file on the host is the baseline, not the goal. Anything
# that can run `docker inspect` can read every value in it, and so can anything that reads
# /proc/<pid>/environ. If OCI Vault is available, pull these at container start instead.
# The values that matter most are PAYMENT_TOKEN_HMAC_SECRET, PAYMENT_OTP_PEPPER,
# ORACLE_PASSWORD and REDIS_PASSWORD.
#
#   chown root:docker env/prod.env && chmod 0640 env/prod.env
ENV_FILE=env/prod.env

SPRING_PROFILES_ACTIVE=prod

# Pin the exact version. Never `latest` in production: `latest` means the image that runs
# after a restart is whatever was pushed since, so "server 3 is running the build we
# tested" becomes a guess. Same tag on all six servers, every time.
APP_VERSION=1.0.0
REGISTRY=registry.internal.tvscredit.co.in/payment

# THIS SERVER's private VCN address. Different on each of the six servers. Published
# ports bind here only - never 0.0.0.0, which on most Docker installs bypasses host
# iptables rules because Docker's own rules are evaluated first.
PRIVATE_IP=10.0.1.11

# Must not overlap the VCN, the Oracle subnet or the LMS network, or container traffic to
# those destinations is routed back into the bridge and silently fails. Keep it identical
# on all six servers so the LMS and Oracle firewall teams allowlist one range.
DOCKER_SUBNET=172.28.0.0/16

# --- Redis -----------------------------------------------------------------------------
# The host running the redis profile. One instance for the environment, shared by all six
# servers - that is what makes a session work regardless of which server the load balancer
# picks, and it is also why this host is the platform's single point of failure. That risk
# is accepted and documented; see HANDOFF_MASTER.md.
REDIS_HOST=10.0.1.10
REDIS_PORT=6379
REDIS_PASSWORD=
# TLS on. What crosses this connection is AES-256 session keys, OTP hashes and upstream
# bearer tokens. Setting this false puts live session keys in plaintext on the subnet, and
# anything that can reach port 6379 can then decrypt that borrower's traffic. Enable the
# TLS block in docker/redis/redis.conf before setting this true, or every service fails to
# connect at startup.
REDIS_TLS=true

# --- Oracle ----------------------------------------------------------------------------
ORACLE_URL=jdbc:oracle:thin:@//oracle-prod.internal:1521/PAYPDB
ORACLE_USER=payment_app
# Special characters: Compose expands $ in env files. A password containing $ must have it
# doubled ($$) or Compose eats it and the connection fails with an authentication error
# that points at the wrong thing. Same trap applies to the bcrypt partner hashes below.
ORACLE_PASSWORD=
ORACLE_SCHEMA=PAYMENT
# Per service instance. Six servers x five services x 20 = 600 sessions at full spread.
# Confirm that against the Oracle PROCESSES and SESSIONS parameters before go-live;
# exhausting them takes down the LMS's own connections too, not just ours.
ORACLE_POOL_MAX=20

# --- LMS -------------------------------------------------------------------------------
GOLDLOAN_FIID=1
GOLDLOAN_TOKEN_URL=https://lms.internal/api/getEXApiToken
GOLDLOAN_FETCH_URL=https://lms.internal/api/goldLoanFetch
GOLDLOAN_OTS_URL=https://lms.internal/api/otsAmount
GOLDLOAN_STATUS_URL=https://lms.internal/api/txnStatus
GOLDLOAN_POST_URL=https://lms.internal/api/postTxn
GOLDLOAN_TOKEN_FIELD=token
GOLDLOAN_TOKEN_TTL=1500

# Concurrent LMS calls allowed PER SERVICE INSTANCE, enforced by the lms bulkhead.
# The number the LMS team agreed to is a platform total, so the arithmetic is:
#   servers x services-calling-LMS x LMS_MAX_CONCURRENT  <=  what the LMS accepts
#   6 x 4 x 100 = 2400, which is almost certainly more than they agreed to.
# Divide the agreed figure, do not copy the development value. Getting this wrong does
# not fail here - it fails as a throttle on their side during month-end peak.
LMS_MAX_CONCURRENT=25

# --- SMS gateway -----------------------------------------------------------------------
SMS_TOKEN_URL=https://sms.internal/api/token
SMS_SEND_URL=https://sms.internal/api/send
SMS_TOKEN_FIELD=access_token
SMS_TOKEN_TTL=1500
# DLT-registered values. Changing the template id without re-registering causes the
# operator to drop the message, which presents as "OTP not received" with a success
# response from the gateway.
SMS_TEMPLATE=TPaymentGatewayLoginIT2095
SMS_EMP_ID=APaymentGatewayLoginIT943
SMS_MAX_CONCURRENT=10

# --- Secrets ---------------------------------------------------------------------------
# openssl rand -base64 48
#
# IDENTICAL ON ALL SIX SERVERS AND ALL FIVE SERVICES. A token is signed by auth and
# verified by the others; a server with a different secret rejects every token issued
# anywhere else. Because the load balancer spreads requests, the symptom is intermittent
# authorisation failures on roughly one request in six - which reads as a load balancer
# problem, not a configuration one. Verify before releasing traffic.
PAYMENT_TOKEN_HMAC_SECRET=
PAYMENT_OTP_PEPPER=

# Rotating the pepper invalidates every stored OTP hash. Do it in a maintenance window,
# not during the day.

# --- Actuator ---------------------------------------------------------------------------
# /actuator/prometheus is not public. It exposes endpoint names, traffic volumes, error
# rates and JVM internals.
ACTUATOR_USER=prometheus
ACTUATOR_PASSWORD=

# --- Web --------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://pay.tvscredit.co.in

# The real number of proxies that append to X-Forwarded-For: API gateway + load balancer
# = 2. Count it, do not assume. Too high and ClientContext trusts a header segment the
# caller controls, so the audit row records whatever address they chose - worse than
# recording none, because it looks authoritative in an investigation.
TRUSTED_PROXY_COUNT=2

TOMCAT_MAX_THREADS=200

# --- Per-service versions ----------------------------------------------------------------
# APP_VERSION above is the release every service follows. These override it for ONE
# service, which is how a fix in one does not restart the other four: set the line, run
# ./docker/deploy.sh with that service name, and only that container is recreated.
#
#   # auth got a hotfix; the rest stay on 1.0.0
#   AUTH_VERSION=1.0.1
#
# ./docker/plan-release.sh works out which services a change actually affects from the git
# diff, and prints these lines for you. It also enforces the rule that overrides all of
# this: if payment-shared or the parent pom changed, every service moves together, because
# payment-shared owns the token format and the Redis key layout.
#
# When all five move, clear these and bump APP_VERSION alone.
#
# AUTH_VERSION=
# FETCH_VERSION=
# SERVICE_VERSION=
# POSTING_VERSION=
# WORKER_VERSION=

# --- Container sizing -------------------------------------------------------------------
# Five services on one server. Leave the host at least 2 CPU and 4GB for the kernel,
# Docker, Promtail and node-exporter, or the OOM-killer starts choosing for you and it
# does not choose the least important container.
AUTH_MEM=2048M
FETCH_MEM=1536M
SERVICE_MEM=1536M
POSTING_MEM=1536M
WORKER_MEM=1536M
AUTH_CPUS=2
FETCH_CPUS=2
SERVICE_CPUS=2
POSTING_CPUS=2
WORKER_CPUS=2
