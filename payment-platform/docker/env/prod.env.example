# Production. Copy to env/prod.env ON THE SERVER. Never commit the filled copy.
#
#   docker compose --env-file env/prod.env --profile app --profile worker up -d
#
#   chown root:docker env/prod.env && chmod 0640 env/prod.env
#
# A 0640 file is the baseline, not the goal — anything that can run `docker inspect` can
# read every value here. If OCI Vault is available, pull the four secrets at start.
ENV_FILE=env/prod.env

SPRING_PROFILES_ACTIVE=prod

# Pin the exact version. Never `latest`: a restart would silently change the running code.
APP_VERSION=1.0.0
REGISTRY=registry.internal.tvscredit.co.in/payment

# THIS server's private address — different on each of the six. Published ports bind
# here only, never 0.0.0.0.
PRIVATE_IP=10.0.1.11

# Must not overlap the VCN, Oracle or LMS networks. Same on all six so the firewall teams
# allowlist one range.
DOCKER_SUBNET=172.28.0.0/16

# --- Redis -----------------------------------------------------------------------------
# The Redis the infra team runs. Nothing in this compose file starts one.
#
# Hand them docker/redis-dev.conf — the header lists the four settings that matter. The
# short version: this is a datastore, not a cache. An LRU eviction policy silently deletes
# anti-replay nonces and live session keys.
REDIS_HOST=10.0.1.10
REDIS_PORT=6379
REDIS_PASSWORD=
# What crosses this connection is AES session keys and OTP hashes. On a flat subnet,
# anything that reaches the port can decrypt a borrower's traffic.
REDIS_TLS=true

# --- Oracle ----------------------------------------------------------------------------
ORACLE_URL=jdbc:oracle:thin:@//oracle-prod.internal:1521/PAYPDB
ORACLE_USER=payment_app
# A $ in a password must be doubled ($$) — Compose expands it otherwise, and the failure
# looks like a wrong credential rather than a mangled one.
ORACLE_PASSWORD=
ORACLE_SCHEMA=PAYMENT
# Per instance. 6 servers x 5 services x 20 = 600 sessions. Check that against the Oracle
# PROCESSES parameter before go-live.
ORACLE_POOL_MAX=20

# --- LMS -------------------------------------------------------------------------------
GOLDLOAN_FIID=1
GOLDLOAN_TOKEN_URL=https://lms.internal/api/getEXApiToken
GOLDLOAN_FETCH_URL=https://lms.internal/api/goldLoanFetch
GOLDLOAN_OTS_URL=https://lms.internal/api/otsAmount
GOLDLOAN_STATUS_URL=https://lms.internal/api/txnStatus
GOLDLOAN_POST_URL=https://lms.internal/api/postTxn
GOLDLOAN_TOKEN_FIELD=token

# PER SERVICE INSTANCE, not a platform total. 6 x 4 x 100 = 2400 concurrent LMS calls,
# which is almost certainly more than they agreed to. Divide the agreed figure. Getting
# this wrong fails as a throttle on their side at month-end, not as an error here.
LMS_MAX_CONCURRENT=25

# --- SMS -------------------------------------------------------------------------------
SMS_TOKEN_URL=https://sms.internal/api/token
SMS_SEND_URL=https://sms.internal/api/send
SMS_TOKEN_FIELD=access_token
# DLT-registered. Changing the template id without re-registering makes the operator drop
# the message, which looks like "OTP not received" with a success from the gateway.
SMS_TEMPLATE=TPaymentGatewayLoginIT2095
SMS_EMP_ID=APaymentGatewayLoginIT943
SMS_MAX_CONCURRENT=10

# --- Secrets ---------------------------------------------------------------------------
# openssl rand -base64 48
#
# BYTE-IDENTICAL ON ALL SIX SERVERS. A server with a different token secret rejects every
# token issued elsewhere; because the load balancer spreads requests, that shows up as
# intermittent auth failures on ~1 request in 6 and reads as a load balancer fault.
#   docker compose --env-file env/prod.env exec auth printenv PAYMENT_TOKEN_HMAC_SECRET | sha256sum
PAYMENT_TOKEN_HMAC_SECRET=
# Rotating this invalidates every stored OTP hash. Maintenance window only.
PAYMENT_OTP_PEPPER=
ACTUATOR_USER=prometheus
ACTUATOR_PASSWORD=

# --- Web --------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://pay.tvscredit.co.in
# The real number of proxies that append to X-Forwarded-For: gateway + LB = 2. Too high
# and the audit row records an address the caller chose — worse than recording none.
TRUSTED_PROXY_COUNT=2
TOMCAT_MAX_THREADS=200

# --- Per-service versions ----------------------------------------------------------------
# Override APP_VERSION for one service so a fix there does not restart the other four.
# Clear them when all five move together.
#   AUTH_VERSION=1.0.1
# AUTH_VERSION=
# FETCH_VERSION=
# SERVICE_VERSION=
# POSTING_VERSION=
# WORKER_VERSION=

# --- Sizing -------------------------------------------------------------------------------
# Five services per server. Leave the host 2 CPU and 4GB for the kernel, Docker and the
# log shipper, or the OOM-killer chooses for you.
AUTH_MEM=2048M
FETCH_MEM=1536M
SERVICE_MEM=1536M
POSTING_MEM=1536M
WORKER_MEM=1536M
AUTH_CPUS=2
FETCH_CPUS=2
SERVICE_CPUS=2
POSTING_CPUS=2
WORKER_CPUS=2
