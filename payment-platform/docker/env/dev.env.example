# Local development.  cp env/dev.env.example env/dev.env
#
#   docker compose --env-file env/dev.env --profile dev --profile app --profile worker up -d
#
# --profile dev starts a Redis on 6363. Already running one? Leave that profile out, or
# the port bind fails.
#
# --env-file does two jobs: it supplies values for substitution in docker-compose.yml,
# and the ENV_FILE line below is what hands the same file to the containers.
ENV_FILE=env/dev.env

SPRING_PROFILES_ACTIVE=dev
APP_VERSION=0.0.0-dev
REGISTRY=payment
PRIVATE_IP=127.0.0.1

# --- Redis -----------------------------------------------------------------------------
# Defaults assume --profile dev, which starts a Redis on this compose network. Containers
# reach it at `redis:6379`; it is also published to 127.0.0.1:6363 so redis-cli and an
# IDE run can reach it, and so the port matches what you already use.
#
#   container port 6379, host port 6363. Which one is right depends on which side you
#   are calling from — that is the thing that catches people.
#
# Running a service from the IDE instead? localhost:6363 — already the default in
# application-dev.properties, so no variables are needed at all.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# USING YOUR OWN REDIS instead of --profile dev? `localhost` inside a container is that
# container's own loopback and reaches nothing, whatever the port. Use the host gateway:
#   REDIS_HOST=host.docker.internal
#   REDIS_PORT=6363
# and make sure your Redis publishes on 0.0.0.0, not 127.0.0.1 — on Linux the host
# gateway is a different address and a loopback-only bind refuses it.

# --- Oracle ----------------------------------------------------------------------------
# Same loopback rule: from a container, your host's Oracle is host.docker.internal.
ORACLE_URL=jdbc:oracle:thin:@//host.docker.internal:1521/XEPDB1
ORACLE_USER=payment_dev
ORACLE_PASSWORD=
ORACLE_SCHEMA=PAYMENT_DEV
ORACLE_POOL_MAX=10

# --- LMS -------------------------------------------------------------------------------
GOLDLOAN_FIID=1
GOLDLOAN_TOKEN_URL=https://lms-uat.internal/api/getEXApiToken
GOLDLOAN_FETCH_URL=https://lms-uat.internal/api/goldLoanFetch
GOLDLOAN_OTS_URL=
GOLDLOAN_STATUS_URL=
GOLDLOAN_POST_URL=
GOLDLOAN_TOKEN_FIELD=token
LMS_MAX_CONCURRENT=20

# --- SMS -------------------------------------------------------------------------------
SMS_TOKEN_URL=https://sms-uat.internal/api/token
SMS_SEND_URL=https://sms-uat.internal/api/send
SMS_TOKEN_FIELD=access_token
SMS_TEMPLATE=TPaymentGatewayLoginIT2095
SMS_EMP_ID=APaymentGatewayLoginIT943
SMS_MAX_CONCURRENT=5

# --- Secrets ---------------------------------------------------------------------------
# openssl rand -base64 48
# Identical across all five, or a token issued by auth is rejected by the others.
PAYMENT_TOKEN_HMAC_SECRET=
PAYMENT_OTP_PEPPER=
ACTUATOR_USER=prometheus
ACTUATOR_PASSWORD=change-me

# --- Web --------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://localhost:4200
# No gateway or load balancer locally, so nothing appends to X-Forwarded-For.
TRUSTED_PROXY_COUNT=0
TOMCAT_MAX_THREADS=50

# --- Per-service versions (optional) -----------------------------------------------------
# Pin one service to a different build and leave the other four running.
# AUTH_VERSION=
# FETCH_VERSION=
# SERVICE_VERSION=
# POSTING_VERSION=
# WORKER_VERSION=

AUTH_MEM=768M
FETCH_MEM=768M
SERVICE_MEM=768M
POSTING_MEM=768M
WORKER_MEM=768M
AUTH_CPUS=1
FETCH_CPUS=1
SERVICE_CPUS=1
POSTING_CPUS=1
WORKER_CPUS=1
