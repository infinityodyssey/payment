# Local development. Copy to env/dev.env and fill in. env/*.env is git-ignored and
# .dockerignore'd; only this .example file is committed.
#
#   cp env/dev.env.example env/dev.env
#   docker compose --env-file env/dev.env --profile app --profile worker up -d
#
# NOTE: no --profile redis. Development uses the Redis already running on your machine.
# The redis profile exists for UAT and production, where the platform owns that instance.
#
# ONE FLAG, TWO JOBS. `--env-file` makes these values available for substitution in
# docker-compose.yml. ENV_FILE below is what hands the same file to the containers. Both
# are needed and they must name the same file, which is why ENV_FILE is set here rather
# than passed separately.
ENV_FILE=env/dev.env

SPRING_PROFILES_ACTIVE=dev
APP_VERSION=0.0.0-dev
REGISTRY=payment

# Loopback, so the published ports are reachable from this machine only.
PRIVATE_IP=127.0.0.1
DOCKER_SUBNET=172.28.0.0/16


# =======================================================================================
# REDIS - your existing local instance on port 6363
# =======================================================================================
#
# READ THIS BEFORE SETTING REDIS_HOST. `localhost` does not mean the same thing in both
# places you might run these services, and getting it wrong produces a connection refused
# that looks like Redis is down when it is running perfectly.
#
#   Running the services FROM YOUR IDE or `mvn spring-boot:run`
#       localhost:6363 is correct. That is also the built-in default in
#       application-dev.properties, so you need no environment variables at all for Redis.
#
#   Running the services IN CONTAINERS (the compose command above)
#       localhost is the CONTAINER's own loopback. There is no Redis inside the container,
#       so localhost:6363 can never reach yours - the port number is irrelevant.
#       Use host.docker.internal, which the compose file maps to the host gateway on
#       Linux as well as Docker Desktop. The port is still the one PUBLISHED on your host.
#
# So, for containers:
REDIS_HOST=host.docker.internal
REDIS_PORT=6363

# ALTERNATIVE, if your local Redis is itself a container and you would rather not rely on
# the host gateway: attach it to this project's network and address it by container name.
#
#   docker network create payment-platform_payment     # if compose has not created it yet
#   docker network connect payment-platform_payment my-redis
#
# Then use the CONTAINER port, not the published one. 6363 is the host-side port from
# `-p 6363:6379`; on the Docker network Redis is still listening on 6379:
#
#   REDIS_HOST=my-redis
#   REDIS_PORT=6379
#
# This is the trap that catches people: the published port and the container port are
# different numbers, and which one is correct depends on which side you are calling from.

# Blank if your local Redis has no password. The services handle an empty password; they
# will not handle a wrong one with a useful error.
REDIS_PASSWORD=

# Plaintext on a local connection. application-dev.properties also sets this false; it is
# repeated here so every environment states it in one place rather than relying on a
# profile you might forget is active.
REDIS_TLS=false

# YOUR LOCAL REDIS ALMOST CERTAINLY HAS DOCKER'S DEFAULTS: no maxmemory, no AOF, and an
# eviction policy that will silently delete anti-replay nonces and live session keys.
# That is survivable in development, and it is also why a bug that only appears under
# memory pressure will not appear here. Check what you have, so you know what you are
# testing against:
#
#   redis-cli -p 6363 CONFIG GET maxmemory-policy appendonly maxmemory
#
# When you move to the real Redis, use docker/redis/redis.conf. The settings in it -
# noeviction above all - are the ones most likely to surprise you, so UAT must run them.


# --- Oracle ----------------------------------------------------------------------------
# A real Oracle, not H2. Same loopback rule as Redis: from a container, your host's Oracle
# is host.docker.internal, not localhost.
ORACLE_URL=jdbc:oracle:thin:@//host.docker.internal:1521/XEPDB1
ORACLE_USER=payment_dev
ORACLE_PASSWORD=change-me
ORACLE_SCHEMA=PAYMENT_DEV
ORACLE_POOL_MAX=10

# --- LMS -------------------------------------------------------------------------------
GOLDLOAN_FIID=1
GOLDLOAN_TOKEN_URL=https://lms-uat.internal/api/getEXApiToken
GOLDLOAN_FETCH_URL=https://lms-uat.internal/api/goldLoanFetch
GOLDLOAN_OTS_URL=
GOLDLOAN_STATUS_URL=
GOLDLOAN_POST_URL=
GOLDLOAN_TOKEN_FIELD=token
GOLDLOAN_TOKEN_TTL=1500
LMS_MAX_CONCURRENT=20

# --- SMS gateway -----------------------------------------------------------------------
SMS_TOKEN_URL=https://sms-uat.internal/api/token
SMS_SEND_URL=https://sms-uat.internal/api/send
SMS_TOKEN_FIELD=access_token
SMS_TOKEN_TTL=1500
SMS_TEMPLATE=TPaymentGatewayLoginIT2095
SMS_EMP_ID=APaymentGatewayLoginIT943
SMS_MAX_CONCURRENT=5

# --- Secrets ---------------------------------------------------------------------------
# Dev values, but still generate them rather than typing a word:
#   openssl rand -base64 48
# Must be identical across all five services or a token issued by auth fails everywhere
# else - which presents as "my token stopped working", not as a configuration error.
PAYMENT_TOKEN_HMAC_SECRET=generate-with-openssl-rand-base64-48
PAYMENT_OTP_PEPPER=generate-with-openssl-rand-base64-48

# --- Actuator ---------------------------------------------------------------------------
ACTUATOR_USER=prometheus
ACTUATOR_PASSWORD=change-me

# --- Web --------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://localhost:4200
# No gateway and no load balancer in front of a local run, so nothing appends to
# X-Forwarded-For. Leave this at 0 locally. Setting it to the production value means
# ClientContext trusts two hops that are not there and records an address the caller chose.
TRUSTED_PROXY_COUNT=0

TOMCAT_MAX_THREADS=50

# --- Per-service versions ---------------------------------------------------------------
# Normally unset: every service then uses APP_VERSION above. Set one to pin that service
# to a different build and leave the other four running untouched - useful when you are
# iterating on a single service.
#
#   AUTH_VERSION=0.0.1-dev
#
# AUTH_VERSION=
# FETCH_VERSION=
# SERVICE_VERSION=
# POSTING_VERSION=
# WORKER_VERSION=

# --- Container sizing -------------------------------------------------------------------
AUTH_MEM=768M
FETCH_MEM=768M
SERVICE_MEM=768M
POSTING_MEM=768M
WORKER_MEM=768M
AUTH_CPUS=1
FETCH_CPUS=1
SERVICE_CPUS=1
POSTING_CPUS=1
WORKER_CPUS=1
